{
	"$schema": "../appsettings.schema.json",
	"AllowedHosts": "*",
	"Basil": {
		"Server": {
			"Domain": "basil.local",
			"Port": 443,
			"CertPath": "./Data/basil.local.pfx",
			"CertPassword": "your-password",
			"AdvertiseDomain": true
		},
		"Database": {
			"ConnectionString": "Host=localhost;Port=5432;Database=basil;Username=basil;Password=your-password",
			"WriteConnections": 8
		},
		"Update": {
			"CheckOnStartup": true,
			"Source": "https://github.com/thnhmai06/osuBasil"
		},
		"Mirror": {
			"DownloadEndpoint": null,
			"SearchEndpoint": null
		},
		"Bot": {
			"Name": "BasilBot",
			"CommandPrefix": "!",
			"Country": "vn"
		},
		"Irc": {
			"Name": "Basil",
			"Port": 6667
		},
		"Logging": {
			"MinimumLevel": "Information"
		}
	}
}
