{
	"Name": "api-only",
	"ServerHost": {
		"Kind": "Dotnet",
		"Domain": "basil.local",
		"Port": 8443,
		"IrcPort": 16667,
		"CertPath": "data/certs/basil.local.pfx",
		"CertPassword": "your-password",
		"StartupTimeoutSeconds": 120,
		"IdleSettleSeconds": 30,
		"Dotnet": {
			"Mode": "Published",
			"PublishDirectory": ".loadtest/server",
			"AutoPublish": true
		}
	},
	"Client": {
		"HttpVersion": "1.1",
		"ConnectionMode": "Shared",
		"MaxConnectionsPerServer": 512,
		"RequestTimeoutSeconds": 30,
		"PollIntervalSeconds": 60
	},
	"Accounts": {
		"Count": 5000,
		"NamePrefix": "load",
		"Password": "loadtest-pw"
	},
	"Metrics": {
		"SampleIntervalSeconds": 1,
		"DotnetCounters": {
			"Enabled": true,
			"RefreshIntervalSeconds": 1
		}
	},
	"Report": {
		"Folder": ".loadtest/reports",
		"Formats": [
			"Html",
			"Csv",
			"Md",
			"Txt"
		]
	},
	"Scenarios": {
		"startup": {
			"Enabled": false
		},
		"login": {
			"Enabled": false,
			"ConcurrentUsers": [],
			"DurationSeconds": 0,
			"WarmUpSeconds": 0
		},
		"idle": {
			"Enabled": false,
			"ConcurrentUsers": [],
			"DurationSeconds": 0,
			"WarmUpSeconds": 0
		},
		"chat": {
			"Enabled": false,
			"ConcurrentUsers": [],
			"DurationSeconds": 0,
			"WarmUpSeconds": 0
		},
		"multiplayer": {
			"Enabled": false,
			"Rooms": [],
			"PlayersPerRoom": 0,
			"RoundsPerRoom": 0,
			"ScoreUpdatesPerSecond": 0,
			"DurationSeconds": 0
		},
		"api": {
			"Enabled": true,
			"ConcurrentUsers": [
				50,
				200,
				500
			],
			"DurationSeconds": 60,
			"WarmUpSeconds": 10,
			"Endpoints": [
				"health",
				"user",
				"match_list",
				"match_report",
				"beatmapset"
			],
			"MixedWeights": {
				"user": 40,
				"match_report": 30,
				"match_list": 20,
				"beatmapset": 10
			},
			"MaxFailCount": 100000
		},
		"sse": {
			"Enabled": false,
			"ConcurrentUsers": [],
			"DurationSeconds": 0,
			"WarmUpSeconds": 0
		},
		"stress": {
			"Enabled": false,
			"ConcurrentUsers": [],
			"RampSeconds": 0,
			"HoldSeconds": 0
		},
		"soak": {
			"Enabled": false,
			"ConcurrentUsers": [],
			"DurationSeconds": 0,
			"WarmUpSeconds": 0,
			"ReportingIntervalSeconds": 300,
			"Weights": {},
			"LeakSlopeThresholds": {}
		}
	}
}
