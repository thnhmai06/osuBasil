{
	"$schema": "./appsettings.schema.json",
	"AllowedHosts": "*",
	"Basil": {
		"Server": {
			"Domain": "basil.local",
			"Bind": "0.0.0.0",
			"Ports": {
				"Https": 443,
				"Irc": 6667
			},
			"Certificate": {
				"Path": "Configurations/basil.local.pfx",
				"Password": "your-password"
			},
			"LanAdvertise": true,
			"TrustedProxies": ["127.0.0.1", "::1"]
		},
		"Storage": {
			"DataDirectory": "Data"
		},
		"Database": {
			"ConnectionString": "Host=localhost;Port=5432;Database=basil;Username=basil;Password=your-password",
			"WriteConnections": 8
		},
		"Logging": {
			"MinimumLevel": "Information",
			"Overrides": {
				"Microsoft": "Warning",
				"Microsoft.Hosting.Lifetime": "Information",
				"System": "Warning"
			},
			"RetentionPeriod": "14.00:00:00"
		},
		"Telemetry": {
			"OtlpEndpoint": null,
			"Metrics": false,
			"Traces": false,
			"Logs": false
		},
		"Updates": {
			"CheckOnStartup": true,
			"Source": "https://github.com/thnhmai06/osuBasil"
		}
	}
}
