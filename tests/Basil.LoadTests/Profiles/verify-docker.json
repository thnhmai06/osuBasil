{
	"Name": "verify-docker",
	"ServerHost": {
		"Kind": "Docker",
		"Domain": "basil.local",
		"Port": 443,
		"IrcPort": 6667,
		"CertPath": "data/certs/basil.local.pfx",
		"CertPassword": "your-password",
		"StartupTimeoutSeconds": 120,
		"IdleSettleSeconds": 5,
		"Docker": {
			"ComposeFile": "docker-compose.yml",
			"ServiceName": "basil"
		}
	},
	"Client": {
		"HttpVersion": "1.1",
		"ConnectionMode": "Shared",
		"MaxConnectionsPerServer": 64,
		"RequestTimeoutSeconds": 15,
		"PollIntervalSeconds": 30
	},
	"Accounts": { "Count": 20, "NamePrefix": "vdock", "Password": "loadtest-pw" },
	"Metrics": { "SampleIntervalSeconds": 2, "DotnetCounters": { "Enabled": false, "RefreshIntervalSeconds": 1 } },
	"Report": { "Folder": ".loadtest/reports", "Formats": ["Csv", "Md"] },
	"Scenarios": {
		"startup": { "Enabled": false },
		"login": {
			"Enabled": true,
			"ConcurrentUsers": [10],
			"DurationSeconds": 15,
			"WarmUpSeconds": 3,
			"WarmBcryptCache": true,
			"PostWarmupSettleSeconds": 11,
			"MaxFailCount": 5000
		},
		"idle": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0 },
		"chat": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0 },
		"multiplayer": { "Enabled": false, "Rooms": [], "PlayersPerRoom": 0, "RoundsPerRoom": 0, "ScoreUpdatesPerSecond": 0, "DurationSeconds": 0 },
		"api": {
			"Enabled": true,
			"ConcurrentUsers": [10],
			"DurationSeconds": 15,
			"WarmUpSeconds": 3,
			"Endpoints": ["health"],
			"MixedWeights": {},
			"MaxFailCount": 5000
		},
		"sse": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0 },
		"stress": { "Enabled": false, "ConcurrentUsers": [], "RampSeconds": 0, "HoldSeconds": 0, "MaxFailCount": 0, "UnusableSuccessRatePercent": 0, "UnusableForSeconds": 0, "SaturationCpuPercent": 0, "SaturationSeconds": 0 },
		"soak": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0, "ReportingIntervalSeconds": 0, "Weights": {}, "LeakSlopeThresholds": {} }
	}
}
