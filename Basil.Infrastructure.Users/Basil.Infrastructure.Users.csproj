<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Basil.Infrastructure.Users</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Basil"/>
		<InternalsVisibleTo Include="Basil.Infrastructure.Persistence"/>
		<InternalsVisibleTo Include="Basil.Infrastructure.Users.Tests"/>
		<InternalsVisibleTo Include="Basil.Application.Users.Tests"/>
		<InternalsVisibleTo Include="Basil.Testing"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Basil.Application.Shared\Basil.Application.Shared.csproj"/>
		<ProjectReference Include="..\Basil.Infrastructure.Shared\Basil.Infrastructure.Shared.csproj"/>
		<ProjectReference Include="..\Basil.Domain\Basil.Domain.csproj"/>
		<ProjectReference Include="..\Basil.Application.Users\Basil.Application.Users.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\assets\avatars\*.png" LogicalName="Avatars.%(Filename)%(Extension)"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mediator.Abstractions"/>
		<PackageReference Include="Microsoft.EntityFrameworkCore"/>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
		<PackageReference Include="Microsoft.Extensions.Options"/>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
	</ItemGroup>
</Project>