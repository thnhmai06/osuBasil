<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<SelfContained>true</SelfContained>
		<Version>1.0.0</Version>
		<FileVersion>1.0.0</FileVersion>
		<Product>Basil</Product>
		<Authors>Mai Thành (thnhmai06)</Authors>
		<Description>A lightweight, high-performance osu! server for tournaments and multiplayer.</Description>
		<Copyright>Copyright © 2026 Mai Thành. Licensed under the MIT License.</Copyright>
		<ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Basil.Application\Basil.Application.csproj"/>
		<ProjectReference Include="..\Basil.Infrastructure\Basil.Infrastructure.csproj"/>
		<ProjectReference Include="..\Basil.Protocol\Basil.Protocol.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\..\assets\avatars\basil.png" Link="Resources\Avatars\basilbot.png"/>
		<EmbeddedResource Include="..\..\assets\avatars\default.png" Link="Resources\Avatars\default.png"/>
	</ItemGroup>

	<ItemGroup>
		<Content Include="docs-site\**" CopyToOutputDirectory="PreserveNewest"/>
		<Content Include="..\..\assets\icon.png" Link="docs-site\icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\data\certs\basil.local.pfx" Link="Data\basil.local.pfx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
		<PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.OpenApi"/>
		<PackageReference Include="Scalar.AspNetCore"/>
		<PackageReference Include="Serilog.AspNetCore"/>
		<PackageReference Include="Serilog.Sinks.Console"/>
		<PackageReference Include="Serilog.Sinks.File"/>
	</ItemGroup>

	<!-- Reduce unnecessary osu! runtime dependencies in self-contained publish output (#5) -->
	<Target Name="RemoveUnusedOsuRulesetRuntimeFiles" AfterTargets="Publish">

		<ItemGroup>
			<_UnusedRuntimeFile Include="$(PublishDir)ppy.ManagedBass.Fx.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)ppy.ManagedBass.Mix.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)ppy.ManagedBass.Wasapi.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)bass.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)bass_fx.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)bassmix.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)basswasapi.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)alsa-sharp.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)avcodec-*.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)avformat-*.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)avutil-*.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)swscale-*.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)FFmpeg.AutoGen.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)ppy.Veldrid*.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Vortice.*.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)SharpGen.Runtime*.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)libveldrid-spirv.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)vk.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)StbiSharp.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)stbi.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)SDL2*.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)SDL3*.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)OpenTabletDriver*.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)HidSharpCore.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Commons.Music.Midi.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)realm-wrappers.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)MongoDB.Bson.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Remotion.Linq.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.SignalR.Client.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.SignalR.Client.Core.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.Http.Connections.Client.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.SignalR.Protocols.MessagePack.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)MessagePack.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)MessagePack.Annotations.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)Markdig.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)HtmlAgilityPack.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)DiffPlex.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)SharpCompress.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)SharpFNT.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)osu.Game.Resources.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Humanizer.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)**/osu.Game.Resources.resources.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)**/Humanizer.resources.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.Toolkit.HighPerformance.dll"/>

			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.SignalR.Protocols.Json.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.SignalR.Common.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.SignalR.Core.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.SignalR.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.Http.Connections.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.Http.Connections.Common.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.Identity.dll"/>
			<_UnusedRuntimeFile Include="$(PublishDir)Microsoft.AspNetCore.Mvc.Razor.dll"/>
		</ItemGroup>

		<Message Importance="Normal" Text="Removing %(_UnusedRuntimeFile.Identity)"/>

		<!-- Directories that only hold the satellite/resource files being deleted below become empty afterwards. -->
		<ItemGroup>
			<_SatelliteResourceFile Include="$(PublishDir)**/osu.Game.Resources.resources.dll"/>
			<_SatelliteResourceFile Include="$(PublishDir)**/Humanizer.resources.dll"/>
			<_SatelliteResourceDirectory Include="@(_SatelliteResourceFile->'%(RootDir)%(Directory)')"/>
		</ItemGroup>

		<Delete Files="@(_UnusedRuntimeFile)"/>
		<RemoveDir Directories="@(_SatelliteResourceDirectory)"/>

	</Target>

</Project>
