<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>false</IsTestProject>
		<RootNamespace>Basil.LoadTests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NBomber"/>
		<PackageReference Include="Microsoft.Extensions.Configuration"/>
		<PackageReference Include="Microsoft.Extensions.Configuration.Json"/>
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
		<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine"/>
		<!-- In-process .NET runtime counters (replaces the dotnet-counters CLI sidecar). -->
		<PackageReference Include="Microsoft.Diagnostics.NETCore.Client"/>
		<PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent"/>
		<!-- Docker Engine API (replaces the docker CLI for stats/logs/stop). -->
		<PackageReference Include="Docker.DotNet"/>
	</ItemGroup>

	<ItemGroup>
		<!-- Reused for wire-format serialization only; no other src/ project referenced. Basil.Web is
		     deliberately NOT referenced here (even with ReferenceOutputAssembly=false, the SDK still
		     rejects referencing a self-contained executable from a non-self-contained one) — the
		     harness builds/publishes it as a subprocess via `dotnet publish` instead. -->
		<ProjectReference Include="..\..\src\Basil.Protocol\Basil.Protocol.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<None Include="Profiles\**" CopyToOutputDirectory="PreserveNewest"/>
		<None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest"/>
	</ItemGroup>

</Project>
