<Project>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<ItemGroup>
		<!--
   			AutoMapper 13.0.1 is brought in transitively by ppy.osu.Rulesets.
   			GHSA-rvv3-g6hj-g44x requires untrusted mapping configuration, which Basil
   			does not expose. Remove this suppression once upstream updates AutoMapper.
 		-->
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x"/>

		<!--
			SixLabors.ImageSharp 3.1.12 is the last release under the Apache licence; the 3.2 line that fixes these
			advisories needs a commercial licence key, which is the owner's decision (kept on 3.1.x). Mitigation:
			uploaded pictures are probed by header first, only PNG and JPEG are decoded (the parsers of the other
			formats never see uploaded bytes), and the byte size and the pixels per side are capped by
			Uploads.ScreenshotMaxSize/ScreenshotMaxSide and Uploads.AvatarMaxSize/AvatarMaxSide before decoding.
			Re-evaluate on every ImageSharp release.
		-->
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4"/>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q"/>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w"/>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2"/>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44"/>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g"/>

		<!--
			MessagePack and the SignalR packages are brought in transitively by ppy.osu.Game (through the rulesets).
			Basil hosts no SignalR hub and never deserializes MessagePack from a client, so the vulnerable code
			paths are not reachable. Remove these suppressions once upstream updates them.
		-->
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h"/>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-334f-vvp4-7g6p"/>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-86xp-94pg-8r6r"/>
	</ItemGroup>

</Project>
