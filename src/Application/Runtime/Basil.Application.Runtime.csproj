<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Events whose handlers live in Basil.Bot, or that nobody handles, are expected to have none here. -->
		<NoWarn>$(NoWarn);MSG0005</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Basil.Application.Runtime.Tests"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Common\Application\Basil.Common.Application.csproj"/>
		<ProjectReference Include="..\Persistence\Basil.Application.Persistence.csproj"/>
		<ProjectReference Include="..\Capabilities\Basil.Application.Capabilities.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mediator.Abstractions"/>
		<PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all"/>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
	</ItemGroup>
</Project>
