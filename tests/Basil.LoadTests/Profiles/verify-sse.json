		"sse": { "Enabled": true, "ConcurrentUsers": [10], "DurationSeconds": 20, "WarmUpSeconds": 2, "MaxFailCount": 10000 },
		"stress": { "Enabled": false, "ConcurrentUsers": [], "RampSeconds": 0, "HoldSeconds": 0, "MaxFailCount": 0, "UnusableSuccessRatePercent": 0, "UnusableForSeconds": 0, "SaturationCpuPercent": 0, "SaturationSeconds": 0 },
		"soak": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0, "ReportingIntervalSeconds": 0, "Weights": {}, "LeakSlopeThresholds": {} }
