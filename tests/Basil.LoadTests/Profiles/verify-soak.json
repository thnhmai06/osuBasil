{
	"Name": "verify-soak",
	"ServerHost": {
		"Kind": "Dotnet",
		"Domain": "basil.local",
		"Port": 8443,
		"IrcPort": 16667,
		"CertPath": "data/certs/basil.local.pfx",
		"CertPassword": "your-password",
		"StartupTimeoutSeconds": 60,
		"IdleSettleSeconds": 5,
		"Dotnet": { "Mode": "Published", "PublishDirectory": ".loadtest/server", "AutoPublish": true }
	},
	"Client": {
		"HttpVersion": "1.1",
		"ConnectionMode": "Shared",
		"MaxConnectionsPerServer": 128,
		"RequestTimeoutSeconds": 15,
		"PollIntervalSeconds": 3
	},
	"Accounts": { "Count": 20, "NamePrefix": "vsoak", "Password": "loadtest-pw" },
	"Metrics": { "SampleIntervalSeconds": 2, "DotnetCounters": { "Enabled": true, "RefreshIntervalSeconds": 1 } },
	"Report": { "Folder": ".loadtest/reports", "Formats": ["Csv", "Md"] },
	"Scenarios": {
		"startup": { "Enabled": false },
		"login": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0 },
		"idle": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0 },
		"chat": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0 },
		"multiplayer": { "Enabled": false, "Rooms": [], "PlayersPerRoom": 0, "RoundsPerRoom": 0, "ScoreUpdatesPerSecond": 0, "DurationSeconds": 0 },
		"api": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0 },
		"sse": { "Enabled": false, "ConcurrentUsers": [], "DurationSeconds": 0, "WarmUpSeconds": 0 },
		"stress": { "Enabled": false, "ConcurrentUsers": [], "RampSeconds": 0, "HoldSeconds": 0, "MaxFailCount": 0, "UnusableSuccessRatePercent": 0, "UnusableForSeconds": 0, "SaturationCpuPercent": 0, "SaturationSeconds": 0 },
		"soak": {
			"Enabled": true,
			"ConcurrentUsers": [20],
			"DurationSeconds": 90,
			"WarmUpSeconds": 3,
			"ReportingIntervalSeconds": 15,
			"Weights": { "chat": 40, "multiplayer": 20, "api": 25, "idle": 15 },
			"LeakSlopeThresholds": { "WorkingSetMbPerHour": 25, "ThreadsPerHour": 5, "HandlesPerHour": 50, "P95MsPerHour": 10 }
		}
	}
}
