<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ManifestTool</RootNamespace>
		<AssemblyName>RulesetManifest</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Basil.Infrastructure.Rulesets\Basil.Infrastructure.Rulesets.csproj"/>
		<ProjectReference Include="..\..\Basil.Infrastructure.Beatmaps\Basil.Infrastructure.Beatmaps.csproj"/>
	</ItemGroup>

	<!-- The stack's own packages, as the server compiles against them (the server project references them privately). -->
	<ItemGroup>
		<PackageReference Include="ppy.osu.Game"/>
		<PackageReference Include="ppy.osu.Game.Rulesets.Osu"/>
		<PackageReference Include="ppy.osu.Game.Rulesets.Taiko"/>
		<PackageReference Include="ppy.osu.Game.Rulesets.Catch"/>
		<PackageReference Include="ppy.osu.Game.Rulesets.Mania"/>
	</ItemGroup>
</Project>
