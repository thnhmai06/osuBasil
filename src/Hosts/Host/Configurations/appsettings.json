{
	"$schema": "./appsettings.schema.json",
	"AllowedHosts": "*",
	"Kestrel": {
		"Endpoints": {
			"Https": {
				"Url": "https://0.0.0.0:443"
			}
		},
		"Certificates": {
			"Default": {
				"Path": "Configurations/basil.local.pfx",
				"Password": "basil"
			}
		}
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"Microsoft.Hosting.Lifetime": "Information",
			"System": "Warning"
		},
		"File": {
			"Enabled": true,
			"Location": "Logs",
			"Rolling": {
				"Interval": "Day",
				"MaxSize": "100MB"
			},
			"Retention": {
				"MaxAge": "14.00:00:00",
				"MaxFiles": 30,
				"MaxSize": "1GB"
			}
		}
	},
	"ConnectionStrings": {
		"Read": "Host=localhost;Port=5432;Database=basil;Username=basil;Password=CHANGE_ME",
		"Write": "Host=localhost;Port=5432;Database=basil;Username=basil;Password=CHANGE_ME"
	},
	"OpenTelemetry": {
		"OtlpEndpoint": null,
		"Metrics": false,
		"Traces": false,
		"Logs": false
	},
	"Basil": {
		"Server": {
			"Name": "Basil",
			"Domain": "basil.local",
			"TrustedProxies": [
				"127.0.0.1",
				"::1"
			],
			"Irc": {
				"Port": 6667
			},
			"Multicast": {
				"Enabled": true,
				"IPv4": "224.0.0.251",
				"IPv6": "FF02::FB",
				"Port": 5353,
				"DnsTtl": 120
			}
		},
		"Storage": {
			"Location": "Data"
		},
		"Database": {
			"Enabled": true,
			"Read": {
				"Provider": "PostgreSQL",
				"PoolSize": 0
			},
			"Write": {
				"Provider": "PostgreSQL",
				"PoolSize": 8
			}
		},
		"Updates": {
			"Source": "https://github.com/thnhmai06/osuBasil",
			"CheckOnStartup": true,
			"Channel": "stable"
		}
	}
}
