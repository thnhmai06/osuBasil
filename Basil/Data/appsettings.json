{
	"$schema": "./appsettings.schema.json",
	"AllowedHosts": "*",
	"Kestrel": {
		"Endpoints": {
			"Http": {
				"Url": "http://0.0.0.0:8080"
			}
		}
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"Microsoft.Hosting.Lifetime": "Information",
			"System": "Warning"
		},
		"File": {
			"Enabled": true,
			"Location": "Logs",
			"Rolling": {
				"Interval": "Day",
				"MaxSize": "100MB"
			},
			"Retention": {
				"MaxAge": "14.00:00:00",
				"MaxFiles": 30,
				"MaxSize": "1GB"
			}
		}
	},
	"OpenTelemetry": {
		"OtlpEndpoint": null,
		"Metrics": false,
		"Traces": false,
		"Logs": false
	},
	"Basil": {
		"Server": {
			"Name": "Basil",
			"Domain": "basil.local",
			"TrustedProxies": [
				"127.0.0.1",
				"::1"
			],
			"Irc": {
				"Port": 6667
			}
		},
		"Database": {
			"Read": {
				"PoolSize": 0
			},
			"Write": {
				"PoolSize": 8
			}
		},
		"Updates": {
			"Source": "https://github.com/thnhmai06/osuBasil",
			"CheckOnStartup": true
		}
	}
}
