<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<ProjectReference Include="..\Basil.Domain\Basil.Domain.csproj"/>
		<ProjectReference Include="..\Basil.Protocol\Basil.Protocol.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
		<PackageReference Include="Microsoft.Extensions.Options"/>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
	</ItemGroup>

	<ItemGroup>
		<!-- ReplyLocale (Services/ReplyLocale.cs) reads this next to the running assembly via
		     AppContext.BaseDirectory. CopyToOutputDirectory here, not just a plain glob-included
		     None item, is what makes every project that references Basil.Application, including
		     the test projects (which never run through Basil.Web's own content-root setup), get
		     a real copy of it alongside their own build output. -->
		<Content Include="Data\Locale\replies.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
